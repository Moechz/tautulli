# ===========================================================================
# Multilingual file for the TOS 7 Docker application "tautullidocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language,
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations" -- run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Tautulli"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Tautulli is a monitoring and statistics companion for Plex Media Server: play history, live streams, bandwidth and library statistics, and notifications. This package runs the official LinuxServer.io image as a non-root container with all Linux capabilities dropped, and keeps its data in the app data folder. Tautulli needs an existing Plex server - sign in, complete the setup wizard with the Plex URL and token, and the dashboard starts collecting usage. Without Plex the web UI, settings and logs still work."
release_note = "2.19.1-3: review remediation for S6, S11, S9, V1 and F5. No credential is shipped any more: the wrapper generates a random admin password at first start, keeps only its PBKDF2 hash in config.ini and writes the plaintext to config/initial-password.txt (600), which is deleted automatically once you change the password. The container drops all capabilities and sets no-new-privileges on top of uid 1000, data is 700/600. The description now matches what runs without Plex. Login-to-dashboard verified by test/smoke.sh."
important    = "Requires DockerEngine and Plex. First login: user tautulli, password generated at first start and stored in DockerAppData/tautullidocker/config/initial-password.txt (mode 600) - change it in Settings, then delete that file. Data stays on your NAS, no telemetry. A normal uninstall keeps the folder, uninstall with data removal deletes it. Plain HTTP on the LAN - use a TLS reverse proxy before exposing it. Privacy policy: see the Help link."

[zh-cn]
name         = "Tautulli"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Tautulli 是 Plex Media Server 的监控与统计面板：记录播放历史、实时会话、带宽和媒体库统计，并可推送通知。本应用运行 LinuxServer.io 官方镜像，以非 root 用户运行并丢弃全部 Linux 能力，数据保存在应用数据目录。Tautulli 需要已有的 Plex 服务器：登录后在向导中填入 Plex 地址与 Token，仪表盘即开始收集数据。未连接 Plex 时网页界面、设置与日志仍可正常使用。"
release_note = "2.19.1-3：针对审核 S6、S11、S9、V1、F5 的整改。包内不再内置任何凭据：首启密码由包装脚本随机生成，config.ini 仅保存 PBKDF2 哈希，明文写入 config/initial-password.txt（权限 600），修改密码后自动删除。容器在 uid 1000 基础上丢弃全部 Linux 能力并启用 no-new-privileges，数据目录 700、关键文件 600。描述已与实际可用功能对齐（无 Plex 时网页界面、设置与日志可用）。已用 test/smoke.sh 实测登录到仪表盘。"
important    = "需要 DockerEngine 和 Plex。初始登录：用户名 tautulli，密码在首次启动时随机生成并写入 DockerAppData/tautullidocker/config/initial-password.txt（权限 600），登录后请在设置中修改密码并删除该文件。数据保存在 NAS，不上报遥测。普通卸载保留数据目录，选择删除数据才会清除。页面为局域网明文 HTTP，暴露公网前请加 TLS 反向代理。隐私政策见帮助链接。"

[zh-hk]
name         = "Tautulli"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Tautulli 是 Plex Media Server 的監控與統計面板：記錄播放歷史、即時工作階段、頻寬和媒體庫統計，並可傳送通知。本應用執行 LinuxServer.io 官方鏡像，以非 root 使用者執行並丟棄全部 Linux 能力，資料儲存在應用程式資料目錄。Tautulli 需要既有的 Plex 伺服器：登入後在精靈中填入 Plex 位址與 Token，儀表板即開始收集資料。未連線 Plex 時網頁介面、設定與日誌仍可正常使用。"
release_note = "2.19.1-3：針對審核 S6、S11、S9、V1、F5 的整改。包內不再內建任何憑證：首啟密碼由包裝指令碼隨機產生，config.ini 僅保存 PBKDF2 雜湊，明文寫入 config/initial-password.txt（權限 600），修改密碼後自動刪除。容器在 uid 1000 基礎上丟棄全部 Linux 能力並啟用 no-new-privileges，資料目錄 700、關鍵檔案 600。描述已與實際可用功能對齊（未連線 Plex 時網頁介面、設定與日誌可用）。已用 test/smoke.sh 實測登入到儀表板。"
important    = "需要 DockerEngine 和 Plex。初始登入：使用者名稱 tautulli，密碼在首次啟動時隨機產生並寫入 DockerAppData/tautullidocker/config/initial-password.txt（權限 600），登入後請在設定中修改密碼並刪除該檔案。資料儲存在 NAS，不上傳遙測。一般解除安裝保留資料目錄，選擇刪除資料才會清除。頁面是區域網路明文 HTTP，暴露公網前請加 TLS 反向代理。隱私政策見說明連結。"

