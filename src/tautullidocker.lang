# ===========================================================================
# Multilingual file for the TOS 7 Docker application "tautullidocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Tautulli"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Tautulli is a monitoring and statistics companion for Plex Media Server. It records play history, shows live streams, bandwidth and library statistics, and can send notifications for new plays. This package runs the official LinuxServer.io Tautulli image as a non-root container; its database, configuration and cache live in the application data folder. Tautulli needs an existing Plex server: open the app, complete the setup wizard with the Plex URL and token, and the dashboard starts collecting data."
release_note = "2.19.1-1: upgraded to Tautulli 2.19.1 (LinuxServer.io build v2.19.1-ls252); first-run wrapper seeds a known admin account (admin / tautulli, change immediately) so the login page is usable without container logs; added privacy policy; clarified Plex requirement and uninstall/data behaviour. Rectified per review comments."
important    = "Requires DockerEngine and Plex; Tautulli shows no statistics until connected. First login: admin / tautulli - change it immediately, then complete the setup wizard with your Plex URL and token. Data stays on your NAS in DockerAppData/tautullidocker; the package sends no telemetry. A normal uninstall keeps the folder for reinstall; uninstall with data removal deletes it. Plain HTTP on the LAN; use a TLS reverse proxy before exposing it. Privacy policy: see the Help link."

[zh-cn]
name         = "Tautulli"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Tautulli 是 Plex Media Server 的监控与统计工具：记录播放历史、实时会话、带宽和媒体库统计，并可发送通知。本应用运行 LinuxServer.io 官方镜像并以非 root 用户运行；数据库、配置和缓存保存在应用数据目录。Tautulli 需要已有的 Plex 服务器：打开应用后在向导里填入 Plex 地址和 Token，仪表盘即开始收集数据。"
release_note = "2.19.1-1：升级到 Tautulli 2.19.1（LinuxServer.io 构建 v2.19.1-ls252）；首启 wrapper 预置初始管理员（admin / tautulli，请立即修改），无需查看容器日志即可登录；新增隐私政策；明确需要 Plex 及卸载/数据行为。已按审核意见整改。"
important    = "需要 DockerEngine 和 Plex；未连接前 Tautulli 不显示统计。初始登录：admin / tautulli，请立即修改，然后在向导中填写 Plex 地址与 Token。数据保存在 NAS 的 DockerAppData/tautullidocker，本应用不上报遥测。普通卸载会保留该目录以便重装，选择删除数据才会清除。页面是局域网明文 HTTP，暴露公网前请加 TLS 反向代理。隐私政策见帮助链接。"

[zh-hk]
name         = "Tautulli"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Tautulli 是 Plex Media Server 的監控與統計工具：記錄播放歷史、即時工作階段、頻寬和媒體庫統計，並可傳送通知。本應用執行 LinuxServer.io 官方鏡像並以非 root 使用者執行；資料庫、設定和快取儲存在應用程式資料目錄。Tautulli 需要既有的 Plex 伺服器：開啟應用後在精靈裡填入 Plex 位址和 Token，儀表板即開始收集資料。"
release_note = "2.19.1-1：升級到 Tautulli 2.19.1（LinuxServer.io 建置 v2.19.1-ls252）；首啟 wrapper 預置初始管理員（admin / tautulli，請立即修改），無需查看容器日誌即可登入；新增隱私政策；明確需要 Plex 及解除安裝/資料行為。已依審核意見整改。"
important    = "需要 DockerEngine 和 Plex；未連線前 Tautulli 不顯示統計。初始登入：admin / tautulli，請立即修改，然後在精靈中填寫 Plex 位址與 Token。資料儲存在 NAS 的 DockerAppData/tautullidocker，本應用不上傳遙測。一般解除安裝會保留該目錄以便重新安裝，選擇刪除資料才會清除。頁面是區域網路明文 HTTP，暴露公網前請加 TLS 反向代理。隱私政策見說明連結。"

